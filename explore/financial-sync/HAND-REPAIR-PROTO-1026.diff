+            LocalDate f = cf.filings().get(a).filed();
+            String form = cf.filings().get(a).form();
+            ClassFacts.Period own = form.startsWith("10-Q") || form.startsWith("6-K")
+                    ? quarterPeriod(cf, cf.weighted(), a) : currentPeriod(cf, cf.weighted(), a, 350, 380);
+            IssuerFacts.Key key = own == null ? null : new IssuerFacts.Key(a, own);
+            Double wv = key == null ? null : cf.weighted().get(key);
+            boolean confirmed = wv != null && wv > 0 && Boolean.TRUE.equals(staticCloses(cf, key, wv));
+            Double prior = null;
