+    // TEMP PROBE — 동점 계측(커밋 금지 · ANCHOR_TIE_OUT=<tsv>)
+    private static final java.io.PrintWriter TIE_OUT;
+    static {
+        String path = System.getenv("ANCHOR_TIE_OUT");
+        java.io.PrintWriter w = null;
+        if (path != null) {
+            try { w = new java.io.PrintWriter(new java.io.FileWriter(path, true), true); }
+            catch (java.io.IOException e) { throw new java.io.UncheckedIOException(e); }
+        }
+        TIE_OUT = w;
+    }
+    private static synchronized void TIE_PROBE(Anchor anchor, SecEdgarColumn column, String tag, Window window,
+                                               Map<Slot, Fact> slots, Fact picked) {
+        if (TIE_OUT == null || picked == null) return;
+        List<Fact> ties = slots.values().stream().filter(f -> f.accn().equals(anchor.accn()))
+                .filter(f -> f.end().equals(picked.end())).toList();
+        if (ties.size() < 2) return;
+        Fact match = ties.stream().filter(f -> window.start().equals(f.start())).findFirst().orElse(null);
+        TIE_OUT.println(String.join("\t", anchor.accn(), column.name(), tag, String.valueOf(window.start()),
+                String.valueOf(window.end()), String.valueOf(ties.size()), picked.start() + "~" + picked.end(),
+                picked.value().toPlainString(), match == null ? "-" : match.value().toPlainString()));
+    }
