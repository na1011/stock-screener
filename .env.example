# 환경변수 예시. 실제 값은 여기 넣지 않는다 — 이 파일은 커밋된다.
# 실제 값은 `.env`(gitignore 대상)나 셸 환경변수로 주입한다.
#
# 사람이 직접 발급해야 하는 것의 절차는 TODO.md에 있다.
# 무엇이 실제로 채워졌는지는 문서가 아니라 `./gradlew checkEnv`가 답한다 —
# 발급은 문서 밖에서 일어나므로 문서가 먼저 낡는다.

# ── 데이터베이스 ────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/stock_screener
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
# ops/ 스크립트가 psql로 물을 때 쓰는 DB 이름. **앱은 이것을 안 쓴다** — 앱은 위의 DB_URL로
# 붙는다. 둘이 갈리면 ops의 "도는 배치가 있다" 경고가 조용히 빈 결과를 내고, 그것은
# "도는 배치 없음"과 구분되지 않는다. DB_URL의 DB 이름을 바꾸면 여기도 함께 바꾼다.
DB_NAME=stock_screener

# ── Google OAuth (Phase 5~6) ───────────────────────────────
# Google Cloud Console에서 발급. 미발급 상태에서도 애플리케이션은 정상 기동하며
# 브라우저 로그인만 동작하지 않는다.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── 데이터 소스 — 국내 (Phase 2 — 가장 먼저 필요) ───────────
# 코스피·코스닥 시세: https://www.data.go.kr/ 활용신청 (승인에 시간이 걸릴 수 있음)
DATA_GO_KR_SERVICE_KEY=your-service-key
# 국내 재무제표: https://opendart.fss.or.kr/
DART_API_KEY=your-dart-api-key

# ── 데이터 소스 — 미국 (v1.1) ───────────────────────────────
# 발급 화면과 검증 명령은 docs/external/us-market-api-setup-guide.md에 있다.
# 아래 셋은 지금 어느 코드도 읽지 않는다 — 미국 어댑터가 아직 없다(ADR-0010). 채워도 동작은
# 그대로이고, checkEnv가 ".env.example에 있으나 .env에 없는 키"로 신고하는 것이 정상이다.
# IMPORTANT: 시세 소스는 아직 확정이 아니다. Alpaca는 그 가이드의 「발급 직후 검증」 절
# 2건(SIP 과거 데이터 · 수정주가 파라미터)을 통과해야 남고, 떨어지면 소스를 다시 고른다 —
# spec의 「미국 시세 소스 (v1.1 착수 시 결정)」 항목이 아직 열려 있다.

# SEC EDGAR (미국 재무) — 키가 없다. 가입도 신청도 없이 바로 호출하고, 대신 신원을 밝히는
# User-Agent를 요구한다. 형식은 `<이름> <연락 가능한 이메일>`이며 개인 이름·개인 메일로 충분
# 하다(회사 도메인은 필요 없다). 안 붙이면 SEC가 "미분류 봇"으로 판정해 차단하는데, HTTP
# 클라이언트가 자기 기본 User-Agent를 자동으로 붙이므로 반드시 명시적으로 덮어써야 한다.
# 시크릿이 아니라 신원 표시다 — 값이 보여도 손해가 없고, 대신 비어 있으면 안 된다.
# MUST: 값을 따옴표로 감싼다. 공백이 들어가는 유일한 키인데 ops/run-app.sh가 이 파일을
# `set -a`로 source한다 — 따옴표가 없으면 운영 기동이 통째로 죽는다(실측: `set -euo pipefail`
# 아래에서 `Name: command not found`로 exit 127, 그 뒤 줄의 키는 아예 안 실린다).
# checkEnv 쪽 파서는 감싼 따옴표를 벗기므로 양쪽에서 같은 값이 된다.
SEC_EDGAR_USER_AGENT="Your Name your-id@example.com"

# Alpaca (미국 시세) — 회원가입 → 이메일 인증 → 인증 앱(MFA) → 키 생성.
# ⚠️ 키를 만들기 전에 대시보드 왼쪽 위를 "Paper Trading"으로 바꾼다. 페이퍼와 라이브는 키가
# 따로 발급되고 서로 호환되지 않아, 라이브 상태에서 만든 키는 나중에 401로만 드러난다
# (403은 인증 헤더가 아예 안 붙은 것, 401은 키 쌍이 틀린 것이다).
# 🔴 Secret Key는 생성 직후 한 번만 표시된다. 놓치면 복구가 아니라 재발급이고 기존 키는 죽는다.
# 이름은 Alpaca SDK 표준 그대로다 — 위 가이드의 검증 curl이 이 두 이름을 참조하므로, 바꾸면
# 그 명령을 그대로 붙여 넣어도 돌지 않는다.
APCA_API_KEY_ID=your-alpaca-key-id
APCA_API_SECRET_KEY=your-alpaca-secret-key

# ── 운영 (Phase 6) ─────────────────────────────────────────
# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token
# Sentry 에러 트래킹 — 백엔드와 프론트는 프로젝트가 다르므로 DSN도 다르다.
# 하나를 양쪽에 쓰면 이슈 그룹핑과 소스맵이 섞여 프론트 스택트레이스가 minify된 채로 남는다.
# 백엔드(Java/Spring Boot 프로젝트)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# 프론트(JavaScript/Vue 프로젝트). VITE_ 접두어가 필수다 — Vite는 그 접두어가 붙은 변수만
# 번들에 노출한다. 번들에 박혀 공개되는 것은 정상이다(DSN은 쓰기 전용 공개 식별자).
# IMPORTANT: Vite는 이 루트 .env를 읽지 않는다(envDir이 frontend/다). 값이 번들에 들어가려면
# frontendBuild 태스크에 주입해야 한다 — 함정은 .claude/rules/config.md에 있다.
VITE_SENTRY_DSN=https://exampleFrontendKey@o0.ingest.sentry.io/1
# 소스맵 업로드용 토큰. DSN과 성격이 정반대다 — DSN은 이벤트를 보내는 공개 식별자고
# 이쪽은 Sentry API에 쓰는 시크릿이다. 없으면 프론트 스택트레이스가 index-a3f9.js:1:28471
# 처럼 minify된 채로만 남아 어느 코드인지 알 수 없다. 백엔드는 필요 없다(소스맵이 없다).
# MUST NOT: VITE_ 접두어를 붙이지 않는다. 붙이면 시크릿이 번들에 그대로 실린다.
SENTRY_AUTH_TOKEN=sntrys_your-org-auth-token
# 소스맵을 어느 프로젝트에 올릴지. 시크릿이 아니라 **조회값**이다 — Sentry 대시보드 주소에
# 그대로 보이는 문자열이며 DSN에는 숫자 ID만 들어 있어 유도할 수 없다. 셋(org·project·토큰)이
# 다 있어야 업로드가 켜지고, 하나라도 없으면 빌드는 성공하되 경고 한 줄을 남긴다.
# 백엔드는 이것이 필요 없다 — 소스맵이라는 개념이 없고 바이트코드에 줄 번호가 들어 있다.
SENTRY_ORG=your-org-slug
SENTRY_PROJECT_FRONTEND=your-frontend-project-slug
# 알림 — 메신저(Slack/Discord 웹훅)와 이메일 두 채널 모두 필요 (spec §8)
# 값이 비어 있으면 그 채널이 비활성이고 알림은 로그로만 떨어진다. 애플리케이션은 그대로 뜬다.
# MUST NOT: 웹훅 URL을 커밋하지 않는다 — URL 자체가 자격증명이라 아는 사람은 누구나 그 채널에 쓴다.
# IMPORTANT: Discord를 쓴다면 URL 끝에 /slack을 붙인다. 안 붙이면 Discord가 400을 내는데,
# 그 실패는 "채널에 아무것도 안 뜬다"로만 보인다(ADR-0025).
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
# (선택) 운영자 수신 주소. 비우면 MAIL_USERNAME으로 간다. 발신과 수신 계정이 다를 때만 채운다.
ALERT_OPERATOR_EMAIL=

# ── 테스트 (기본값이 있어 보통 설정할 필요 없다) ────────────
TEST_DB_URL=jdbc:postgresql://localhost:5432/stock_screener_test
TEST_DB_USER=your_db_user
TEST_DB_PASSWORD=
