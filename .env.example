# 환경변수 예시. 실제 값은 여기 넣지 않는다 — 이 파일은 커밋된다.
# 실제 값은 `.env`(gitignore 대상)나 셸 환경변수로 주입한다.

# 데이터베이스
DB_URL=jdbc:postgresql://localhost:5432/stock_screener
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Google OAuth (Google Cloud Console에서 발급)
# 발급 전에는 비워두어도 애플리케이션은 기동된다. OAuth 로그인만 동작하지 않는다.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# 테스트 DB (기본값이 있어 보통 설정할 필요 없다)
TEST_DB_URL=jdbc:postgresql://localhost:5432/stock_screener_test
TEST_DB_USER=your_db_user
TEST_DB_PASSWORD=
